{
  "blockedFilenamePatterns": [
    ".env",
    ".env.*",
    "!.env.example",
    "!.env.sample",
    "!.env.template",
    "*.pem",
    "*_rsa",
    "*_dsa",
    "*_ed25519",
    "id_rsa*",
    "*.key",
    "*.pfx",
    "*.p12",
    "*.keystore",
    "*credentials*.json",
    "*serviceaccount*.json"
  ],
  "contentPatterns": [
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
    "(?i)(api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret|password)\\s*[:=]\\s*[\"'][A-Za-z0-9/_.+=-]{12,}[\"']"
  ],
  "exemptRepos": []
}
